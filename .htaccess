# ONE in Marriage — server rules for public_html.
# http -> https is switched on in cPanel (Domains -> Force HTTPS Redirect),
# so it is not repeated here.

RewriteEngine On

# One address for the site: www.oneinmarriage.com -> oneinmarriage.com.
# Certificate renewals under /.well-known/ are left alone.
RewriteCond %{HTTP_HOST} ^www\.oneinmarriage\.com$ [NC]
RewriteCond %{REQUEST_URI} !^/\.well-known/
RewriteRule ^(.*)$ https://oneinmarriage.com/$1 [L,R=301]

# Cache images and fonts for a year (a changed image gets a new file name);
# always revalidate the pages themselves.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 month"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# The payment log is written beside the pages, so it would otherwise be
# downloadable by anyone. The code that writes it lives in payment-config.php,
# which holds the live Stripe key and is never re-uploaded, so it is blocked
# here instead. Written both ways so it works whichever Apache GoDaddy runs.
<Files "paylog.txt">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</Files>

# Logs, backups, spreadsheets, notes and upload zips are never served.
<FilesMatch "\.(log|bak|sql|zip|csv|md)$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
